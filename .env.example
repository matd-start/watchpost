# Copia este archivo a `.env` y cambia la clave.
# `.env` está en .gitignore: los secretos no se suben al repositorio.

# --- Servidor y agente (misma clave, debe coincidir en los dos) ---
WATCHPOST_API_KEY=cambia-esta-clave

# --- Servidor ---
WATCHPOST_DATABASE_URL=sqlite:///data/watchpost.db
# Un host se considera en línea si reportó en los últimos N segundos (RN-04)
WATCHPOST_ONLINE_THRESHOLD_SECONDS=60

# --- Agente ---
WATCHPOST_SERVER_URL=http://127.0.0.1:8000
# Si se deja vacío, se usa el nombre de la máquina
# WATCHPOST_HOST=
WATCHPOST_INTERVAL_SECONDS=10
# Si se deja vacío, se usa la raíz del sistema (C:\ en Windows, / en Linux)
# WATCHPOST_DISK_PATH=
